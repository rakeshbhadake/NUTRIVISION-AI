# Copy to .env at the project root. Never commit .env.
# Generate secrets with: python -c "import secrets; print(secrets.token_urlsafe(48))"
DJANGO_SECRET_KEY=
INTERNAL_SERVICE_TOKEN=
WEBHOOK_SIGNING_SECRET=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,django
FRONTEND_URL=http://127.0.0.1:5173
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
SECURE_SSL_REDIRECT=false
REQUIRE_EMAIL_VERIFICATION=false

# PostgreSQL is the default; Supabase connection must include sslmode=require.
DATABASE_URL=postgresql://nutrivision:REPLACE_ME@127.0.0.1:5432/nutrivision
POSTGRES_DB=nutrivision
POSTGRES_USER=nutrivision
POSTGRES_PASSWORD=
# Explicit local-only fallback when PostgreSQL is not installed.
USE_SQLITE=false
REDIS_URL=
AI_SERVICE_URL=http://127.0.0.1:8001
INTEGRATIONS_SERVICE_URL=http://127.0.0.1:8002

# AI and nutrition providers. These values must NEVER use a VITE_ prefix.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
USDA_API_KEY=
OPENFOODFACTS_USER_AGENT=NutriVisionAI/1.0 (replace-with-your-contact-url)
WEBHOOK_DATABASE_PATH=./data/webhooks.sqlite3

# Console email is local development only. Production: django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=NutriVision <noreply@example.com>
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=

# Optional private S3-compatible object storage (including Supabase Storage S3).
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=ap-south-1
